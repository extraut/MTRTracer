<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MTRTracer</AssemblyName>
    <RootNamespace>MTRTracer.Linux</RootNamespace>
    <Version>1.1.1</Version>
    <Product>MTRTracer</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTRTracer.Core\MTRTracer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <!-- Same embedded UI as the Windows build; served on 127.0.0.1 at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\ui\dist\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="mtrtracer.png" LogicalName="mtrtracer.png" Condition="Exists('mtrtracer.png')" />
  </ItemGroup>

</Project>
